{
  "info": {
    "_postman_id": "b00c57e0-1a2b-4c3d-8e4f-9a0b1c2d3e4f",
    "name": "Book Store API",
    "description": "REST API for an online bookstore (Spring Boot 3 + JWT).\n\nUsage:\n1. Set the collection variable `baseUrl` (default http://localhost:8080). For the Docker Compose setup use http://localhost:8088 (SPRING_LOCAL_PORT).\n2. Run Auth > Register (optional), then Auth > Login. Login stores the JWT in the `token` collection variable.\n3. All other requests inherit Bearer {{token}} auth at the collection level.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password123\",\n  \"repeatPassword\": \"Password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"shippingAddress\": \"123 Main St, Springfield\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registration"
              ]
            },
            "description": "Register a new user. Public endpoint. Returns the created user without the password. Duplicate email returns 409."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.token) {",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "}",
                  "pm.test(\"token saved\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"token\")).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate with email and password. Public endpoint. Returns { \"token\": \"...\" }. The test script saves the token into the `token` collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=0&size=20&sort=title,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "title,asc"
                }
              ]
            },
            "description": "List all books. Roles: USER, ADMIN. Supports pagination and sorting."
          },
          "response": []
        },
        {
          "name": "Search books",
          "request": {
            "method": "GET",
            "header": [],
