            "description": "Get a single book by id. Roles: USER, ADMIN."
          },
          "response": []
        },
        {
          "name": "Create book (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"price\": 39.99,\n  \"description\": \"A Handbook of Agile Software Craftsmanship\",\n  \"coverImage\": \"https://example.com/clean-code.jpg\",\n  \"categoryIds\": [1]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Create a book. Role: ADMIN. price must be positive; title, author and isbn are required."
          },
          "response": []
        },
        {
          "name": "Update book (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code (2nd printing)\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"price\": 42.50,\n  \"description\": \"A Handbook of Agile Software Craftsmanship\",\n  \"coverImage\": \"https://example.com/clean-code.jpg\",\n  \"categoryIds\": [1]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "1"
              ]
            },
            "description": "Update a book by id. Role: ADMIN."
          },
          "response": []
        },
        {
          "name": "Delete book (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "1"
              ]
            },
            "description": "Soft delete a book by id (sets is_deleted = true). Role: ADMIN. Returns 204 No Content."
          },
          "response": []
        }
      ]
    },
