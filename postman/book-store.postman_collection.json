              "path": [
                "api",
                "books",
                "search"
              ],
              "query": [
                {
                  "key": "titles",
                  "value": "Clean Code"
                },
                {
                  "key": "authors",
                  "value": "Robert C. Martin"
                },
                {
                  "key": "isbns",
                  "value": "9780132350884",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Search books by titles, authors and/or isbns (each parameter is repeatable). Roles: USER, ADMIN."
          },
          "response": []
        },
        {
          "name": "Get book by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "1"
              ]
